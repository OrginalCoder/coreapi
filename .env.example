# Django Settings
# Ishlab chiqishda (local) DEBUG=True, PythonAnywhereda DEBUG=False qiling
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-key
DJANGO_DEBUG=False
# PythonAnywhere uchun: yourusername.pythonanywhere.com qo'shiladi
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.pythonanywhere.com

# External AI Provider Configuration
# Supported provider types: groq (recommended, no Docker needed), openai_compatible, freegpt4
AI_PROVIDER_TYPE=groq

# Groq Cloud API configuration (Free tier, no Docker needed, PythonAnywhere compatible):
# Get your free key at https://console.groq.com/keys
AI_PROVIDER_API_KEY=gsk_your_groq_api_key_here
AI_PROVIDER_MODEL=openai/gpt-oss-20b
# Other popular Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant

# HTTP timeout in seconds
AI_PROVIDER_TIMEOUT=60

# Optional: Custom OpenAI-compatible base URL (if AI_PROVIDER_TYPE=openai_compatible)
AI_PROVIDER_URL=https://api.groq.com/openai/v1
AI_PROVIDER_KEYWORD=text

# Security: Rate Limiting (Throttling) per IP
# Format: <number>/<minute|hour|day>
AI_RATE_LIMIT=20/minute
